# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# This project is Next.js, so the browser-visible prefix is NEXT_PUBLIC_ (the
# VITE_ names in the build brief are the Vite equivalent of these two).

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Publishable / anon key. Safe in the bundle — Row Level Security is what protects
# the data, and the public read policy only ever returns visible posts.
# New projects show this as `sb_publishable_…`; older ones as the long `eyJ…` JWT
# labelled "anon public". Either value works.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias, since that is the name most
# existing projects and deploy configs already use for the same value. Set one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────

# Absolute origin used for canonicals, OG urls and JSON-LD. Must match lib/data.ts
# `siteUrl` in production.
NEXT_PUBLIC_SITE_URL=https://drjayeshsardhara.com

# Instant rollback switch. Set to `false` and the site serves only the 180 migrated
# markdown posts — no Supabase call is made anywhere. Anything other than the exact
# string "false" leaves the CMS on.
CMS_ENABLED=true

# ─── Secrets (server only — never NEXT_PUBLIC_) ──────────────────────────────

# Shared secret for POST /api/revalidate, sent as `Authorization: Bearer …`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Optional. Enables AI-worded rewrites in the SEO Suggest panel; without it the
# panel falls back to the deterministic template generator, which needs no key.
# Only ONE is needed. The request is made server-side by /api/seo-suggest so the
# key never reaches the browser.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Existing ────────────────────────────────────────────────────────────────

# Cloudflare R2 base for migrated /wp-content/uploads media. Leave unset locally;
# those files are served straight from public/. See next.config.ts.
R2_PUBLIC_BASE=

# ─── Appointment form ────────────────────────────────────────────────────────

# Resend API key. Without it POST /api/appointment returns 503 and the form shows a
# failure with the practice phone number — it never reports a success it cannot back up.
# Get one at https://resend.com → API Keys.
RESEND_API_KEY=

# Optional. Where appointment requests are delivered.
# Defaults to nextdot.agency@gmail.com when unset.
APPOINTMENT_TO=

# Optional. Sender address. Defaults to "Appointments <onboarding@resend.dev>", Resend's
# shared sender — which ONLY delivers to the Resend account owner's own address. To send
# anywhere else, verify a domain in Resend and set this to an address on it.
APPOINTMENT_FROM=
