# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# This project is Next.js, so the browser-visible prefix is NEXT_PUBLIC_ (the
# VITE_ names in the build brief are the Vite equivalent of these two).

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Publishable / anon key. Safe in the bundle — Row Level Security is what protects
# the data, and the public read policy only ever returns visible posts.
# New projects show this as `sb_publishable_…`; older ones as the long `eyJ…` JWT
# labelled "anon public". Either value works.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias, since that is the name most
# existing projects and deploy configs already use for the same value. Set one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────

# Absolute origin used for canonicals, OG urls and JSON-LD. Must match lib/data.ts
# `siteUrl` in production.
NEXT_PUBLIC_SITE_URL=https://drjayeshsardhara.com

# Instant rollback switch. Set to `false` and the site serves only the 180 migrated
# markdown posts — no Supabase call is made anywhere. Anything other than the exact
# string "false" leaves the CMS on.
CMS_ENABLED=true

# ─── Secrets (server only — never NEXT_PUBLIC_) ──────────────────────────────

# Shared secret for POST /api/revalidate, sent as `Authorization: Bearer …`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Optional. Enables AI-worded rewrites in the SEO Suggest panel; without it the
# panel falls back to the deterministic template generator, which needs no key.
# Only ONE is needed. The request is made server-side by /api/seo-suggest so the
# key never reaches the browser.
#
# GEMINI_API_KEY also powers the AI blog generator below.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── AI blog generator ─────────────────────────────────────────────

# Which provider answers /api/admin/ai/* and the SEO Suggest panel:
#   bazaarlink  BazaarLink (OpenAI-compatible gateway); requires BAZAARLINK_API_KEY below
#   sarvam      Sarvam AI; requires SARVAM_API_KEY below
#   gemini      Google Gemini; requires GEMINI_API_KEY above
#   mock        answers locally, no network, no quota — for tests and UI work
# Unset means the first of bazaarlink, sarvam, gemini whose key is set, else mock.
# The Generate page states which one is live.
AI_PROVIDER=

# ─── BazaarLink (https://bazaarlink.ai) ──────────────────────────────────────

# API key (sk-bl-…). Sent as `Authorization: Bearer …`, server-side only.
BAZAARLINK_API_KEY=

# Optional. Any model id from GET https://api.bazaarlink.ai/v1/models. Defaults to
# gpt-6-luna — low cost ($0.10 in / $0.50 out per million tokens), adjustable
# reasoning, and reliable JSON-schema output.
BAZAARLINK_MODEL=

# Optional. Model for topic candidates only. Empty means BAZAARLINK_MODEL.
BAZAARLINK_TOPICS_MODEL=

# Optional. Ceiling on output tokens per request. Defaults to 16384. Billing is on
# tokens actually produced, so this is a safety cap, not a cost.
BAZAARLINK_MAX_TOKENS=

# Optional. none | low | medium | high | xhigh | max. Defaults to low. Reasoning
# tokens are billed as output, so lower is cheaper; models without adjustable
# reasoning ignore it.
BAZAARLINK_REASONING_EFFORT=

# ─── Sarvam AI (https://dashboard.sarvam.ai) ─────────────────────────────────

# API subscription key (sk_…). Sent as the api-subscription-key header, server-side only.
SARVAM_API_KEY=

# Optional. Model for every operation. Defaults to sarvam-105b.
SARVAM_MODEL=

# Optional. Model for topic candidates only. Empty means SARVAM_MODEL.
SARVAM_TOPICS_MODEL=

# Optional. Ceiling on output tokens per request. Defaults to 4096, the Starter
# plan's limit. Raise it on Pro (16K) or Business (128K) — a full article with its
# metadata is long, and Sarvam counts reasoning tokens against this same limit.
SARVAM_MAX_TOKENS=

# Optional. low | medium | high | max | none. Defaults to low, so reasoning does
# not consume the output budget the answer needs. Higher is slower and costlier.
SARVAM_REASONING_EFFORT=

# Optional. Defaults to the alias `gemini-flash-latest`, which never goes stale.
#
# Pinned ids get retired, and they fail hard when they do: gemini-2.0-flash and
# then gemini-2.5-flash both began answering 404 within a day of each other,
# stopping generation until the code was edited. The alias avoids that.
#
# Set this to a specific id only if you need reproducible output — and expect to
# change it when that id is retired. List what your key can reach with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
#
# A 503 from a model means high demand, not a broken id — the route already waits
# and retries once before reporting it.
#
# Shared with the SEO Suggest panel, so there is one model id to keep current.
GEMINI_MODEL=

# Optional. The model for topic candidates only — "Generate topic candidates" on
# Monthly Topics and the "Suggest keywords" button. Empty means GEMINI_MODEL.
#
# Topic research returns a short structured list, not an article, so a faster
# model can suit it where the main model's long reasoning runs past the 120s
# request timeout. Everything else — planning, writing, review, the Content
# Brain and SEO Suggest — stays on GEMINI_MODEL.
#
# This picks a model per operation; it is not a fallback. A topics request goes
# to this one model only, and a 429/503 on it is never retried on another model.
# Note the free-tier daily quota is counted per model, so each model you use has
# its own allowance.
GEMINI_TOPICS_MODEL=

# NOTE: no service-role key is needed, or wanted. Every AI route acts as the
# signed-in admin under the existing RLS policies, which is also why the monthly
# batch is started by hand rather than by a timer: a cron job has no user to be.


# ─── Existing ────────────────────────────────────────────────────────────────

# Cloudflare R2 base for migrated /wp-content/uploads media. Leave unset locally;
# those files are served straight from public/. See next.config.ts.
R2_PUBLIC_BASE=

# ─── Appointment form ────────────────────────────────────────────────────────

# POST /api/appointment relays to FormSubmit (https://formsubmit.co), which needs no API
# key and no verified domain. Nothing here is required to make the form work.
#
# ACTIVATION: the first submission to a new address makes FormSubmit email that address a
# confirmation link — nothing is delivered until someone clicks it. Submit the form once
# after deploying (or after changing the address below) and confirm from the inbox.

# FormSubmit rejects a submission that arrives with no origin, so the route sends
# NEXT_PUBLIC_SITE_URL (above) as the Origin header — keep that value correct.

# Optional. Where appointment requests are delivered. Defaults to nextdot.agency@gmail.com.
# Accepts either the address or the hashed token FormSubmit issues after activation; the
# token keeps the address out of the outbound request URL.
APPOINTMENT_TO=
